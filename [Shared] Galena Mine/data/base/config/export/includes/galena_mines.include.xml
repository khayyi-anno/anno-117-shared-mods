  <!-- Gold Ore byproduct: same mechanism as the Cupellation Furnace's Silver byproduct (Effect emitted by the
       building itself grants a BuildingBuff with FactoryUpgrade/AdditionalOutput). Deliberately rare (1 per 20 cycles) since Gold Ore (base price 80) is worth ~7x Lead Ore (4)
       and this is meant as an occasional bonus while mining lead, not a real gold-mining strategy. Tune
       AdditionalOutputCycle below if 1/20 feels off in-game. Applies to both mine variants. -->
  <Asset>
    <Template>Effect</Template>
    <Values>
      <Standard>
        <GUID>1780117063</GUID>
        <Name>Effect Lead Mine Gold Ore Byproduct</Name>
        <IconFilename>data/shared-galena-mine/ui/icon_galenaoreb.png</IconFilename>
      </Standard>
      <Effect>
        <EffectScope>ObjectsInMeta</EffectScope>
        <SourceCategory>Adjacency</SourceCategory>
        <Buffs>
          <Item>
            <GUID>1780117064</GUID>
          </Item>
        </Buffs>
        <Targets>
          <Item>
            <GUID>1780117020</GUID>
          </Item>
          <Item>
            <GUID>1780117023</GUID>
          </Item>
        </Targets>
        <EffectIconCategory>Positive</EffectIconCategory>
        <HideInGovernorsBar>1</HideInGovernorsBar>
      </Effect>
      <Text>
        <OasisId>1780117065</OasisId>
      </Text>
    </Values>
  </Asset>

  <Asset>
    <Template>BuildingBuff</Template>
    <Values>
      <Standard>
        <GUID>1780117064</GUID>
        <Name>Buff Lead Mine Gold Ore Byproduct</Name>
        <IconFilename>data/shared-galena-mine/ui/icon_galenaoreb.png</IconFilename>
      </Standard>
      <Text>
        <OasisId>1780117065</OasisId>
      </Text>
      <Buff>
        <SourceCategory>Adjacency</SourceCategory>
      </Buff>
      <FactoryUpgrade>
