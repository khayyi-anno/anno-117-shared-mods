          <Item>
            <Product>31697</Product>
            <AdditionalOutputCycle>20</AdditionalOutputCycle>
            <Amount>1</Amount>
          </Item>
        </AdditionalOutput>
      </FactoryUpgrade>
    </Values>
  </Asset>

