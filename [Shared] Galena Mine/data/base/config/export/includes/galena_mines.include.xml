  <!-- Kill switch: without CI (no Mealhouse pool to join), give the Smith variant the same optional-aqueduct
       bonus as the Merchant variant/vanilla mines instead, so it isn't left with no productivity bonus at all.
       Untested syntax: "!#modid" negation on a Group Condition is assumed valid by analogy with the Anno 1800
       ModOps grammar (positive "#modid" Group Conditions are confirmed working elsewhere in this file and in
       the Uber Patch) but has not been seen anywhere in the corpus and has not been tested in-game. If the
       loader rejects it, drop this whole Group and the Smith variant simply has no aqueduct option, as before. -->
  <Group Condition="!#celtic-independence-overhaul-jtmzac">
    <ModOp Type="add" GUID="1780117023" Path="/Values">
      <AqueductConsumer>
        <AqueductConsumptionType>Optional</AqueductConsumptionType>
        <AqueductConsumedWaterSupply>10</AqueductConsumedWaterSupply>
        <AqueductConsumptionBuffEffect>
          <Item>
            <ProductivityBuff>28480</ProductivityBuff>
          </Item>
        </AqueductConsumptionBuffEffect>
        <UnlockToActivateConsumption>26950</UnlockToActivateConsumption>
      </AqueductConsumer>
    </ModOp>

    <ModOp Type="add" GUID="71200" Path="/Values/AssetPool/AssetList">
      <Item><Asset>1780117023</Asset></Item>
    </ModOp>

  </Group>

