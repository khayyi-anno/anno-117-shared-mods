    <IconFilename>data/base/ui/icons/papyrus_stalks.png</IconFilename>
  </ModOp>
  <ModOp Type="Replace" GUID="151997" Path="/Values/Standard/InfoDescription">
    <InfoDescription>1556231012</InfoDescription>
  </ModOp>
  <ModOp Type="Replace" GUID="151997" Path="/Values/Text/OasisId">
